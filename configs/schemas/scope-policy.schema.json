{
 "$comment": "Rules of engagement, machine-enforced. Default-deny for anything that mutates state or generates volume.",
 "type": "object",
 "required": [
  "schema",
  "deny_classes"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "scope-policy/1"
  },
  "description": {
   "type": "string"
  },
  "deny_classes": {
   "type": "array",
   "items": {
    "enum": [
     "state_mutating",
     "volumetric",
     "destructive",
     "infrastructure_pivot",
     "bulk_extraction",
     "injection",
     "oversize",
     "malformed",
     "direct_transport",
     "transport_probe"
    ]
   }
  },
  "allow_endpoints": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "deny_endpoints": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "allow_methods": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "max_risk": {
   "enum": [
    "read_only",
    "mutating",
    "volumetric",
    "destructive"
   ]
  },
  "authorisations": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "classes",
     "authorised_by",
     "authorised_on",
     "reference"
    ],
    "additionalProperties": false,
    "properties": {
     "classes": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1
     },
     "endpoints": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "authorised_by": {
      "type": "string",
      "minLength": 1
     },
     "authorised_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "reference": {
      "type": "string",
      "minLength": 1
     },
     "expires_on": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "$comment": {
   "type": "string"
  },
  "require_proxy": {
   "$comment": "When true, any case that would be sent outside the intercepting proxy requires an authorisation for class 'direct_transport'. TLS and client-certificate evidence must be captured direct, so that authorisation is expected on engagements that assess transport posture.",
   "type": "boolean"
  }
 }
}