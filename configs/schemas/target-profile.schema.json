{
  "$comment": "apiscan-assessment target profile. Describes an assessment surface. Contains NO credentials: every secret is referenced as ${ENV:NAME} and resolved from the engagement secret file at runtime.",
  "type": "object",
  "required": [
    "schema",
    "identity",
    "transport",
    "auth",
    "endpoints",
    "payload_templates",
    "response_model"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "target-profile/1"
    },
    "identity": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "description": {
          "type": "string"
        },
        "engagement_ref": {
          "type": "string"
        }
      }
    },
    "transport": {
      "type": "object",
      "required": [
        "base_url"
      ],
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "proxy": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 300
        },
        "delay_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "tls_verify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "system",
                "ca",
                "insecure"
              ]
            },
            "ca_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "$comment": {
              "type": "string"
            }
          },
          "$comment": "system (default): verify against the host trust store. ca: verify against ca_path, which MUST exist -- a missing file is a hard failure, never a silent downgrade. insecure: do not verify; this has to be written here deliberately and it is reported as a limitation in the deliverable."
        },
        "client_cert": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "none",
                "direct",
                "proxy"
              ]
            },
            "cert_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "key_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_response_bytes": {
          "$comment": "Refuse to download a response larger than this. Protects the operator's disk and stops one pathological endpoint consuming a run's budget. The engagement mode applies its own ceiling as well; the lower of the two wins.",
          "type": "integer",
          "minimum": 1024,
          "maximum": 134217728
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "provider",
        "identities",
        "default_identity"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "none",
            "header_token",
            "bearer",
            "basic"
          ]
        },
        "default_identity": {
          "type": "string"
        },
        "identities": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z0-9._-]+$": {
              "type": "object",
              "required": [
                "purpose"
              ],
              "additionalProperties": false,
              "properties": {
                "purpose": {
                  "enum": [
                    "positive",
                    "wrong_role",
                    "invalid_credential",
                    "unauthenticated"
                  ]
                },
                "role": {
                  "type": "string"
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "identifier_space": {
            "type": "string"
          },
          "payload_template": {
            "type": "string"
          },
          "state_verification": {
            "$comment": "How to READ BACK what a data-changing request to this endpoint did. Declaring it lets the framework confirm that a request which appeared to be accepted actually changed something -- and, just as important, lets it say NOT VERIFIED when there is no way to check. Omit it when the API offers no read path: the deliverable then states that the resulting state was unverifiable rather than implying it was checked.",
            "type": "object",
            "required": [
              "read_endpoint"
            ],
            "additionalProperties": false,
            "properties": {
              "read_endpoint": {
                "$comment": "Endpoint id to read from.",
                "type": "string"
              },
              "method": {
                "type": "string",
                "default": "GET"
              },
              "identifier_in": {
                "$comment": "Where the identifier goes in the read request.",
                "enum": [
                  "query",
                  "path_suffix",
                  "body"
                ]
              },
              "query_param": {
                "type": "string"
              },
              "body_path": {
                "type": "string"
              },
              "present_markers": {
                "$comment": "Strings in the read response that mean the record exists. Their absence means it does not.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "absent_markers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "identifier_spaces": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "generator"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "generator": {
            "type": "string",
            "pattern": "^(hex:\\d+|uuid4|pattern:.+|literal:.+)$"
          },
          "example": {
            "type": "string"
          }
        }
      }
    },
    "payload_templates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "body",
          "identifier_path"
        ],
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "object"
          },
          "identifier_path": {
            "type": "string"
          },
          "correlation_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "status_flag_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "note_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "mutable_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "response_model": {
      "type": "object",
      "required": [
        "status_layers"
      ],
      "additionalProperties": false,
      "properties": {
        "status_layers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^([1-5][0-9]{2}|[1-5]xx|default)$"
          },
          "additionalProperties": {
            "enum": [
              "edge_reject",
              "auth_reject",
              "method_reject",
              "ctype_reject",
              "validation_reject",
              "server_error",
              "route_404",
              "business_reached",
              "accepted_success",
              "other",
              "business_reject",
              "edge_block",
              "transport_error"
            ]
          }
        },
        "envelope": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "code_path": {
              "type": "string"
            },
            "remark_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "data_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "success_values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "auth_failure_values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "edge_block_markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "business_markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verdict_policy": {
          "enum": [
            "layered",
            "validation_strict"
          ]
        }
      }
    },
    "fidelity_expectations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "large_body_bytes": {
          "type": "integer",
          "minimum": 1024
        },
        "large_body_status": {
          "type": "string"
        },
        "nul_byte_status": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$comment": {
      "type": "string"
    },
    "redaction": {
      "$comment": "Optional. Extends the redaction applied when a redacted copy of evidence is produced for distribution. Credential headers, credential shapes and the profile's own ${ENV:...} values are always redacted; this adds engagement-specific fields. Patterns are regular expressions.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extra_env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "header_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include_pii": {
          "type": "boolean"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pattern"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "controlled_resources": {
      "$comment": "Resources whose OWNER IS KNOWN, for object-level authorisation testing. An ownership finding is only sound when the tester knows who owns the object: reading a record back as the wrong identity proves nothing if nobody knows whose record it was, and guessing identifiers risks touching a real customer's data. Each entry names a resource created or supplied for the engagement and the identity that owns it. When this is empty, ownership cases are NOT generated and the deliverable records object-level authorisation as not established.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "identifier",
          "owned_by",
          "endpoint"
        ],
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "$comment": "The object identifier, as the API expects it.",
            "type": "string"
          },
          "owned_by": {
            "$comment": "Name of the auth.identities entry that owns it.",
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "provenance": {
            "$comment": "How this resource came to exist and why its ownership is known -- e.g. 'created by the tester as identity primary on 2026-01-02'. Required reading for anyone auditing the finding.",
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
