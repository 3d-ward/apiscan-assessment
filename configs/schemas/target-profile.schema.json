{
  "$comment": "apiscan-assessment target profile. Describes an assessment surface. Contains NO credentials: every secret is referenced as ${ENV:NAME} and resolved from the engagement secret file at runtime.",
  "type": "object",
  "required": [
    "schema",
    "identity",
    "transport",
    "auth",
    "endpoints",
    "payload_templates",
    "response_model"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "target-profile/1"
    },
    "identity": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "description": {
          "type": "string"
        },
        "engagement_ref": {
          "type": "string"
        }
      }
    },
    "transport": {
      "type": "object",
      "required": [
        "base_url"
      ],
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "proxy": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 300
        },
        "delay_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "tls_verify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "ca",
                "insecure"
              ]
            },
            "ca_path": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "client_cert": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "none",
                "direct",
                "proxy"
              ]
            },
            "cert_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "key_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "provider",
        "identities",
        "default_identity"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "none",
            "header_token",
            "bearer",
            "basic"
          ]
        },
        "default_identity": {
          "type": "string"
        },
        "identities": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z0-9._-]+$": {
              "type": "object",
              "required": [
                "purpose"
              ],
              "additionalProperties": false,
              "properties": {
                "purpose": {
                  "enum": [
                    "positive",
                    "wrong_role",
                    "invalid_credential",
                    "unauthenticated"
                  ]
                },
                "role": {
                  "type": "string"
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "identifier_space": {
            "type": "string"
          },
          "payload_template": {
            "type": "string"
          }
        }
      }
    },
    "identifier_spaces": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "generator"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "generator": {
            "type": "string",
            "pattern": "^(hex:\\d+|uuid4|pattern:.+|literal:.+)$"
          },
          "example": {
            "type": "string"
          }
        }
      }
    },
    "payload_templates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "body",
          "identifier_path"
        ],
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "object"
          },
          "identifier_path": {
            "type": "string"
          },
          "correlation_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "status_flag_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "note_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "mutable_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "response_model": {
      "type": "object",
      "required": [
        "status_layers"
      ],
      "additionalProperties": false,
      "properties": {
        "status_layers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^([1-5][0-9]{2}|[1-5]xx|default)$"
          },
          "additionalProperties": {
            "enum": [
              "edge_reject",
              "auth_reject",
              "method_reject",
              "ctype_reject",
              "validation_reject",
              "server_error",
              "route_404",
              "business_reached",
              "accepted_success",
              "other",
              "business_reject",
              "edge_block",
              "transport_error"
            ]
          }
        },
        "envelope": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "code_path": {
              "type": "string"
            },
            "remark_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "data_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "success_values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "auth_failure_values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "edge_block_markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "business_markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verdict_policy": {
          "enum": [
            "layered",
            "validation_strict"
          ]
        }
      }
    },
    "fidelity_expectations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "large_body_bytes": {
          "type": "integer",
          "minimum": 1024
        },
        "large_body_status": {
          "type": "string"
        },
        "nul_byte_status": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$comment": {
      "type": "string"
    }
  }
}