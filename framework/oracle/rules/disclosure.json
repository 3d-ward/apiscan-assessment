{
  "$comment": "Information-disclosure detectors. EXTRACTED (CAP-009) from a Java/Python/SQL-biased set; extended to .NET, Go, Node, PHP, Ruby and cloud metadata as an ENGINEERING IMPROVEMENT. Data, not code, so an engagement can extend without touching the engine.",
  "schema": "detector-rules/1",
  "rules": [
    {"id": "DISC-STACK-JAVA", "name": "Java stack trace disclosed", "severity": "High",
     "cwe": "CWE-209: Generation of Error Message Containing Sensitive Information",
     "pattern": "(at [a-zA-Z_$][\\w$]*(?:\\.[\\w$]+)+\\([A-Za-z0-9_$]+\\.java:\\d+\\)|java\\.lang\\.[A-Za-z]+(?:Exception|Error)|org\\.springframework\\.|javax\\.servlet\\.|jakarta\\.servlet\\.)"},
    {"id": "DISC-STACK-PYTHON", "name": "Python traceback disclosed", "severity": "High",
     "cwe": "CWE-209", "pattern": "(Traceback \\(most recent call last\\)|File \"[^\"]+\\.py\", line \\d+)"},
    {"id": "DISC-STACK-DOTNET", "name": ".NET stack trace disclosed", "severity": "High",
     "cwe": "CWE-209", "pattern": "(System\\.[A-Za-z.]+Exception|at [A-Za-z0-9_.]+\\(\\) in [A-Za-z]:\\\\|Microsoft\\.AspNetCore\\.)"},
    {"id": "DISC-STACK-NODE", "name": "Node.js stack trace disclosed", "severity": "High",
     "cwe": "CWE-209", "pattern": "(at [A-Za-z0-9_.<>\\[\\] ]+ \\(/[^)]*node_modules/|ReferenceError:|TypeError: Cannot read propert)"},
    {"id": "DISC-STACK-PHP", "name": "PHP error or stack trace disclosed", "severity": "High",
     "cwe": "CWE-209", "pattern": "(PHP (?:Warning|Fatal error|Notice|Parse error):|Stack trace:\\s*#0 |on line \\d+ in /)"},
    {"id": "DISC-STACK-GO", "name": "Go panic disclosed", "severity": "High",
     "cwe": "CWE-209", "pattern": "(goroutine \\d+ \\[running\\]:|panic: runtime error:)"},
    {"id": "DISC-STACK-RUBY", "name": "Ruby stack trace disclosed", "severity": "High",
     "cwe": "CWE-209", "pattern": "([a-z_/]+\\.rb:\\d+:in `|ActionController::|ActiveRecord::)"},
    {"id": "DISC-SQL", "name": "SQL error detail disclosed", "severity": "High",
     "cwe": "CWE-209",
     "pattern": "(SQLException|SQLSTATE\\[|ORA-\\d{5}|syntax error at or near|You have an error in your SQL syntax|Unclosed quotation mark after|PSQLException|psycopg2\\.|SQLiteException|Microsoft OLE DB Provider for SQL Server|pg_query\\(\\))",
     "flags": "i"},
    {"id": "DISC-PATH-UNIX", "name": "Internal filesystem path disclosed", "severity": "Low",
     "cwe": "CWE-200: Exposure of Sensitive Information to an Unauthorized Actor",
     "pattern": "(/(?:usr|opt|srv|home|var)/(?:local/)?[a-zA-Z0-9_.-]+/[a-zA-Z0-9_./-]+|/Users/[a-zA-Z0-9_.-]+/)"},
    {"id": "DISC-PATH-WIN", "name": "Internal Windows path disclosed", "severity": "Low",
     "cwe": "CWE-200", "pattern": "[A-Za-z]:\\\\(?:inetpub|Windows|Program Files|Users)\\\\"},
    {"id": "DISC-DEBUG", "name": "Debug or diagnostic payload disclosed", "severity": "Low",
     "cwe": "CWE-489: Active Debug Code",
     "pattern": "(\"(?:stackTrace|stack_trace|debugInfo|__debug)\"\\s*:|X-Debug-Token|Whitelabel Error Page|DEBUG = True)"},
    {"id": "DISC-VERSION", "name": "Component version disclosed in body", "severity": "Informational",
     "cwe": "CWE-200",
     "pattern": "(Apache/\\d|nginx/\\d|Microsoft-IIS/\\d|Spring Boot \\(v?\\d|Express/\\d|gunicorn/\\d|Jetty\\(\\d)"},
    {"id": "DISC-INTERNAL-HOST", "name": "Internal hostname or private address disclosed", "severity": "Low",
     "cwe": "CWE-200",
     "pattern": "\\b(?:10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}|[a-z0-9-]+\\.(?:internal|local|corp|lan|intranet))\\b"},
    {"id": "DISC-CLOUD-META", "name": "Cloud metadata or credential structure disclosed", "severity": "High",
     "cwe": "CWE-200",
     "pattern": "(169\\.254\\.169\\.254|\"AccessKeyId\"|\"SecretAccessKey\"|ASIA[0-9A-Z]{16}|AKIA[0-9A-Z]{16})"},
    {"id": "DISC-SECRET-SHAPE", "name": "Credential-shaped value disclosed in response", "severity": "High",
     "cwe": "CWE-522: Insufficiently Protected Credentials",
     "pattern": "(-----BEGIN [A-Z ]*PRIVATE KEY-----|\"(?:password|passwd|secret|api_?key|client_?secret)\"\\s*:\\s*\"[^\"]{4,})",
     "flags": "i"}
  ]
}
